#!/usr/bin/env bash
# VERSION=2
# SOS gateway remote-action agent. Listens on  <prefix>/gateway/<id>/sos/cmd  for commands from the VPS backend and answers on
# <prefix>/gateway/<id>/sos/cmd-result. Run by systemd (sos-gateway-agent.service) as root.
#
# SAFETY (read before changing anything here):
#   * a fixed action whitelist. Structured parameters exist only for apply_config/update and are range/schema checked;
#     no message field is ever evaluated as a command line.
#   * every command must carry  sig = HMAC-SHA256(AGENT_KEY, "<id>|<action>|<ts>");  wrong/missing signature -> ignored
#   * commands older (or newer) than SOS_AGENT_MAX_AGE seconds (default 120) are ignored; ids already seen are ignored (replay)
#   * the key is per gateway (copy it from the dashboard: Gateways -> this gateway -> "Remote control"); keep /etc/sos-gateway.env mode 600
# Test without a broker or root:   SOS_AGENT_DRYRUN=1 sos-gateway-agent --stdin < commands.jsonl   (prints results instead of acting)
set -u
CONF="${SOS_AGENT_CONF:-/etc/sos-gateway.env}"; [ -f "$CONF" ] && . "$CONF"
GATEWAY_ID="${GATEWAY_ID:-}"; TOPIC_PREFIX="${TOPIC_PREFIX:-as923}"; AGENT_KEY="${AGENT_KEY:-}"
STATE_DIR="${SOS_AGENT_STATE:-/var/lib/sos-gateway}"; MAX_AGE="${SOS_AGENT_MAX_AGE:-120}"; DRYRUN="${SOS_AGENT_DRYRUN:-0}"
export XDG_CONFIG_HOME="${SOS_PUB_CONF_DIR:-/etc/sos-gateway}"        # holds the mosquitto_pub / mosquitto_sub option files

[[ "$GATEWAY_ID" =~ ^[0-9a-f]{16}$ ]] || { echo "GATEWAY_ID missing/bad in $CONF" >&2; exit 1; }
[ "${#AGENT_KEY}" -ge 32 ] || { echo "AGENT_KEY missing in $CONF — copy it from the dashboard (Gateways -> Remote control)" >&2; exit 1; }
mkdir -p "$STATE_DIR"; SEEN="$STATE_DIR/agent_seen"; touch "$SEEN"
RES_TOPIC="$TOPIC_PREFIX/gateway/$GATEWAY_ID/sos/cmd-result"

log()   { echo "sos-gateway-agent: $*" >&2; }
reply() {   # reply <id> <ok:true|false> <detail> [output]
  local json; json="$(jq -cn --arg id "$1" --argjson ok "$2" --arg d "$3" --arg o "${4:-}" '{id:$id, ok:$ok, detail:$d, output:$o}')" || return 1
  if [ "$DRYRUN" = 1 ]; then echo "RESULT $json"; else timeout 20 mosquitto_pub -q 1 -i "sos-agent-pub-$GATEWAY_ID" -t "$RES_TOPIC" -m "$json" || log "could not publish result"; fi
}
act() { if [ "$DRYRUN" = 1 ]; then echo "DRYRUN $*"; return 0; fi; "$@"; }     # the ONLY place that touches the system
redact() { sed -E 's/((pass(word)?|secret|token|key)[=:] *)[^ ]+/\1***/Ig'; }

apply_config() {
  local p="$1" ver gain level lat lon interval cfg tmp backup timer_dir timer_file timer_backup
  ver="$(jq -r '.version' <<<"$p")"; gain="$(jq -r '.antenna_gain' <<<"$p")"; level="$(jq -r '.log_level' <<<"$p")"
  lat="$(jq -r '.latitude' <<<"$p")"; lon="$(jq -r '.longitude' <<<"$p")"; interval="$(jq -r '.report_interval_s' <<<"$p")"
  jq -e '((keys|sort) == ["antenna_gain","latitude","log_level","longitude","report_interval_s","version"]) and
    (.version|type=="number" and floor==. and .>=1 and .<=2147483647) and
    (.antenna_gain|type=="number" and .>=0 and .<=30) and
    (.log_level|IN("TRACE","DEBUG","INFO","WARN","ERROR")) and
    (.latitude|type=="number" and .>=-90 and .<=90) and (.longitude|type=="number" and .>=-180 and .<=180) and
    ((.latitude != 0) or (.longitude != 0)) and
    (.report_interval_s|type=="number" and floor==. and .>=30 and .<=3600)' <<<"$p" >/dev/null || return 2
  cfg=/etc/chirpstack-concentratord/concentratord.toml; [ -f "$cfg" ] || return 3
  tmp="$(mktemp)"; backup="$(mktemp)"; cp "$cfg" "$backup"
  sed -E -e "s/^[[:space:]]*log_level=.*/  log_level=\"$level\"/" \
    -e "s/^[[:space:]]*antenna_gain=.*/  antenna_gain=$gain/" \
    -e "s/^[[:space:]]*latitude=.*/    latitude=$lat/" \
    -e "s/^[[:space:]]*longitude=.*/    longitude=$lon/" "$cfg" >"$tmp" || { rm -f "$tmp" "$backup"; return 4; }
  python3 -c 'import sys,tomllib; tomllib.load(open(sys.argv[1],"rb"))' "$tmp" >/dev/null 2>&1 || { rm -f "$tmp" "$backup"; return 5; }
  timer_dir=/etc/systemd/system/sos-gateway-report.timer.d; timer_file="$timer_dir/override.conf"; mkdir -p "$timer_dir"
  timer_backup="$(mktemp)"; [ -f "$timer_file" ] && cp "$timer_file" "$timer_backup" || : >"$timer_backup"
  install -m 644 "$tmp" "$cfg"
  printf '[Timer]\nOnUnitActiveSec=\nOnUnitActiveSec=%ss\n' "$interval" >"$timer_file"
  systemctl daemon-reload
  if systemctl restart chirpstack-concentratord && sleep 3 && systemctl is-active --quiet chirpstack-concentratord \
      && systemctl restart chirpstack-mqtt-forwarder && systemctl restart sos-gateway-report.timer; then
    jq -n --argjson version "$ver" --argjson antenna_gain "$gain" --arg log_level "$level" --argjson latitude "$lat" \
      --argjson longitude "$lon" --argjson report_interval_s "$interval" \
      '{version:$version,antenna_gain:$antenna_gain,log_level:$log_level,latitude:$latitude,longitude:$longitude,report_interval_s:$report_interval_s}' \
      >/etc/sos-gateway-config.json
    chmod 600 /etc/sos-gateway-config.json; rm -f "$tmp" "$backup" "$timer_backup"; return 0
  fi
  install -m 644 "$backup" "$cfg"
  if [ -s "$timer_backup" ]; then install -m 644 "$timer_backup" "$timer_file"; else rm -f "$timer_file"; fi
  systemctl daemon-reload; systemctl restart chirpstack-concentratord chirpstack-mqtt-forwarder sos-gateway-report.timer || true
  rm -f "$tmp" "$backup" "$timer_backup"; return 6
}

update_gateway() {
  local p version url sha work archive root f backup old_version
  jq -e '((keys|sort) == ["sha256","url","version"]) and (.version|type=="string" and test("^[0-9A-Za-z._+:-]{1,48}$")) and
    (.url|type=="string" and test("^https://")) and (.sha256|type=="string" and test("^[0-9a-f]{64}$"))' <<<"$p" >/dev/null || return 2
  version="$(jq -r '.version' <<<"$p")"; url="$(jq -r '.url' <<<"$p")"; sha="$(jq -r '.sha256' <<<"$p")"
  work="$(mktemp -d)"; archive="$work/gateway.tar.gz"; root="$work/root"; backup="$work/backup"; mkdir -p "$root" "$backup"
  old_version="$(cat /etc/sos-gateway-version 2>/dev/null || true)"
  curl -fsSL --proto '=https' --proto-redir '=https' --max-time 120 -o "$archive" "$url" || { rm -rf "$work"; return 3; }
  [ "$(sha256sum "$archive" | awk '{print $1}')" = "$sha" ] || { rm -rf "$work"; return 4; }
  tar -tzf "$archive" | grep -Eq '(^/|(^|/)\.\.(/|$))' && { rm -rf "$work"; return 5; }
  tar -xzf "$archive" -C "$root" || { rm -rf "$work"; return 5; }
  for f in sos-gateway-agent sos-gateway-report sos-gateway-health; do
    [ -f "$root/bin/$f" ] && [ ! -L "$root/bin/$f" ] || { rm -rf "$work"; return 6; }
    bash -n "$root/bin/$f" || { rm -rf "$work"; return 6; }
    cp "/usr/local/bin/$f" "$backup/$f"
  done
  for f in sos-gateway-agent sos-gateway-report sos-gateway-health; do install -m 755 "$root/bin/$f" "/usr/local/bin/$f"; done
  printf '%s\n' "$version" >/etc/sos-gateway-version
  if /usr/local/bin/sos-gateway-report --print >/dev/null && systemctl restart sos-gateway-health.timer sos-gateway-report.timer; then
    rm -rf "$work"; return 0
  fi
  for f in sos-gateway-agent sos-gateway-report sos-gateway-health; do install -m 755 "$backup/$f" "/usr/local/bin/$f"; done
  printf '%s\n' "$old_version" >/etc/sos-gateway-version
  rm -rf "$work"; return 7
}

handle() {
  local line="$1" id action ts sig now age exp params has_params signed rc
  [ "${#line}" -le 1000 ] || { log "oversized message ignored"; return; }
  read -r id action ts sig < <(printf '%s' "$line" | jq -r '[(.id|strings), (.action|strings), (.ts|numbers|floor|tostring), (.sig|strings)] | @tsv' 2>/dev/null) || true
  [[ "${id:-}" =~ ^[0-9a-f]{16}$ && "${ts:-}" =~ ^[0-9]{9,12}$ && "${sig:-}" =~ ^[0-9a-f]{64}$ ]] || { log "malformed command ignored"; return; }
  case "$action" in report_now|logs|restart_services|reboot|apply_config|update) ;; *) log "unknown action ignored"; return ;; esac
  has_params="$(jq -r 'has("params")' <<<"$line" 2>/dev/null)"; params="$(jq -cS '.params // {}' <<<"$line" 2>/dev/null)" || return
  signed="$id|$action|$ts"; [ "$has_params" = true ] && signed="$signed|$params"
  exp="$(printf '%s' "$signed" | openssl dgst -sha256 -hmac "$AGENT_KEY" -r | cut -d' ' -f1)"
  [ "$exp" = "$sig" ] || { log "BAD SIGNATURE ($action) ignored"; return; }
  now="$(date +%s)"; age=$(( now - ts )); [ "$age" -lt 0 ] && age=$(( -age ))
  [ "$age" -le "$MAX_AGE" ] || { log "stale command ($age s) ignored — is the clock (chrony) in sync?"; return; }
  grep -qx "$id" "$SEEN" && { log "replayed id ignored"; return; }
  echo "$id" >> "$SEEN"; tail -n 100 "$SEEN" > "$SEEN.tmp" && mv "$SEEN.tmp" "$SEEN"
  log "running $action ($id)"
  case "$action" in
    report_now)
      if act /usr/local/bin/sos-gateway-report; then reply "$id" true "ส่งรายงานแล้ว"; else reply "$id" false "ส่งรายงานไม่สำเร็จ"; fi ;;
    logs)
      local out; out="$(act journalctl -u chirpstack-concentratord -u chirpstack-mqtt-forwarder -n 40 --no-pager -o short 2>&1 | redact | tail -c 3500)"
      reply "$id" true "log ล่าสุด" "$out" ;;
    restart_services)
      if act systemctl restart chirpstack-concentratord && { [ "$DRYRUN" = 1 ] || sleep 3; } && act systemctl restart chirpstack-mqtt-forwarder; then
        reply "$id" true "รีสตาร์ทบริการแล้ว"; [ "$DRYRUN" = 1 ] || { sleep 5; /usr/local/bin/sos-gateway-report || true; }
      else reply "$id" false "รีสตาร์ทไม่สำเร็จ"; fi ;;
    reboot)
      reply "$id" true "จะรีบูตใน 5 วินาที (ปุ่มผู้ป่วยจะส่งไม่ได้ประมาณ 1–2 นาที)"
      act systemd-run --on-active=5s --unit="sos-agent-reboot-$id" systemctl reboot >/dev/null 2>&1 ;;
    apply_config)
      if [ "$DRYRUN" = 1 ]; then reply "$id" true "DRYRUN: ตรวจค่าแล้ว" "$params"
      else apply_config "$params"; rc=$?; [ "$rc" = 0 ] && reply "$id" true "นำค่าตั้งไปใช้แล้ว" || reply "$id" false "ใช้ค่าไม่สำเร็จ ย้อนกลับค่าเดิมแล้ว (code $rc)"; fi ;;
    update)
      if [ "$DRYRUN" = 1 ]; then reply "$id" true "DRYRUN: ตรวจ release แล้ว" "$(jq -r .version <<<"$params")"
      else update_gateway "$params"; rc=$?
        if [ "$rc" = 0 ]; then
          reply "$id" true "อัปเดตแล้ว" "$(jq -r .version <<<"$params")"
          systemd-run --on-active=3s --unit="sos-agent-restart-$id" systemctl restart sos-gateway-agent >/dev/null 2>&1 || true
        else reply "$id" false "อัปเดตไม่สำเร็จ/ย้อนกลับแล้ว (code $rc)"; fi
      fi ;;
  esac
}

if [ "${1:-}" = "--stdin" ]; then
  while IFS= read -r l; do handle "$l"; done; exit 0
fi
log "listening on $TOPIC_PREFIX/gateway/$GATEWAY_ID/sos/cmd"
# no clean-session flag: a command that arrives while we are offline is NOT queued for later (it would be stale anyway)
mosquitto_sub -q 1 -i "sos-agent-$GATEWAY_ID" -t "$TOPIC_PREFIX/gateway/$GATEWAY_ID/sos/cmd" | while IFS= read -r l; do handle "$l"; done
exit 1      # mosquitto_sub ended (broker/network gone) -> systemd restarts us
