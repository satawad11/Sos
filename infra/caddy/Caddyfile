# Requests that come through Cloudflare's proxy ("orange cloud") carry the visitor's real address in CF-Connecting-IP.
# It is believed ONLY when the connection itself comes from a Cloudflare edge (https://www.cloudflare.com/ips/), so nobody
# can fake it by sending the header directly; client_ip in the sites below is then the visitor, not Cloudflare.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}
	reverse_proxy backend:8000
}

# Optional extra sites, e.g. the ChirpStack admin UI on its own domain.
# Created by scripts/enable-chirpstack-domain.sh; nothing here = no extra sites.
import /etc/caddy/sites/*.caddy
