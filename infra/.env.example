# Copy to .env — scripts/init.sh generates all the random secrets for you.
DOMAIN=sos.example.org
ADMIN_USER=admin
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
CHIRPSTACK_DB_PASSWORD=
SOS_DB_PASSWORD=
CHIRPSTACK_API_SECRET=
MQTT_CHIRPSTACK_PASSWORD=
MQTT_BACKEND_PASSWORD=
JWT_SECRET=
# set after creating the ChirpStack application (step 5 of the VPS guide)
CHIRPSTACK_APP_ID=
# for the web provisioning page: ChirpStack tenant API key ("provision") and Device profile id (SOS-button)
CHIRPSTACK_API_KEY=
CHIRPSTACK_PROFILE_ID=
# optional: ChirpStack web UI on its own domain (set by scripts/enable-chirpstack-domain.sh), e.g. lns.dmtc.ac.th
CS_DOMAIN=
# from LINE Developers console (Messaging API channel)
LINE_CHANNEL_TOKEN=
LINE_CHANNEL_SECRET=
# Optional approved Gateway bundles. Keep as one JSON line; the dashboard cannot submit an arbitrary URL.
# Example: [{"version":"1.0.1","url":"https://github.com/ORG/REPO/releases/download/gw-1.0.1/gateway.tar.gz","sha256":"64_HEX_CHARS"}]
GATEWAY_RELEASES_JSON=[]
