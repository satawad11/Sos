# Linux scripts/configs must keep LF even when the repo is cloned on Windows (CRLF breaks bash: "bash\r").
*.sh        text eol=lf
*.toml      text eol=lf
*.template  text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
gateway/pi/bin/*  text eol=lf
infra/**    text eol=lf
# Windows launchers
*.bat       text eol=crlf
*.ps1       text eol=crlf
